{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ICAT layout review",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "pages"],
  "properties": {
    "summary": { "type": "string", "maxLength": 2000 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pageIndex", "similarity", "findings", "adjustments"],
        "properties": {
          "pageIndex": { "type": "integer", "minimum": 0, "maximum": 399 },
          "similarity": { "type": "number", "minimum": 0, "maximum": 1 },
          "findings": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string", "maxLength": 500 }
          },
          "adjustments": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["objectId", "x", "y", "width", "height", "fontSizePx", "textAlign", "confidence", "reason"],
              "properties": {
                "objectId": { "type": "string", "minLength": 1, "maxLength": 120 },
                "x": { "type": ["number", "null"], "minimum": 0, "maximum": 2500 },
                "y": { "type": ["number", "null"], "minimum": 0, "maximum": 4000 },
                "width": { "type": ["number", "null"], "minimum": 12, "maximum": 5000 },
                "height": { "type": ["number", "null"], "minimum": 12, "maximum": 8000 },
                "fontSizePx": { "type": ["number", "null"], "minimum": 6, "maximum": 96 },
                "textAlign": { "type": ["string", "null"], "enum": ["left", "center", "right", "justify", null] },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "reason": { "type": "string", "maxLength": 500 }
              }
            }
          }
        }
      }
    }
  }
}
