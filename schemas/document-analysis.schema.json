{
  "$id": "https://icat.local/schemas/document-analysis.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ICAT document analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentTitle",
    "languages",
    "pages"
  ],
  "properties": {
    "documentTitle": {
      "type": "string",
      "maxLength": 500
    },
    "languages": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pageIndex",
          "languages",
          "segments",
          "tables"
        ],
        "properties": {
          "pageIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 399
          },
          "languages": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "segments": {
            "type": "array",
            "maxItems": 12000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segmentId",
                "type",
                "sourceText",
                "readingOrder",
                "flowGroup",
                "tableId",
                "rowIndex",
                "columnIndex",
                "rowSpan",
                "columnSpan",
                "regions",
                "style",
                "confidence",
                "needsReview",
                "notes",
                "borders"
              ],
              "properties": {
                "segmentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "table",
                    "table_cell",
                    "stamp",
                    "seal",
                    "signature",
                    "handwriting",
                    "logo",
                    "image",
                    "unknown"
                  ]
                },
                "sourceText": {
                  "type": "string",
                  "maxLength": 100000
                },
                "readingOrder": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 12000
                },
                "flowGroup": {
                  "type": "string",
                  "maxLength": 120
                },
                "tableId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 120
                },
                "rowIndex": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 999
                },
                "columnIndex": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 999
                },
                "rowSpan": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 100
                },
                "columnSpan": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 100
                },
                "regions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height"
                    ],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "width": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1
                      },
                      "height": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                },
                "style": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "fontSizePt",
                    "fontWeight",
                    "fontStyle",
                    "textAlign",
                    "fontFamily",
                    "lineHeight",
                    "color"
                  ],
                  "properties": {
                    "fontFamily": {
                      "type": "string",
                      "enum": [
                        "Arial",
                        "Aptos",
                        "Calibri",
                        "Cambria",
                        "Times New Roman",
                        "Georgia",
                        "Verdana",
                        "Tahoma",
                        "Courier New"
                      ]
                    },
                    "lineHeight": {
                      "type": "number",
                      "minimum": 0.8,
                      "maximum": 3
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "fontSizePt": {
                      "type": "number",
                      "minimum": 4,
                      "maximum": 96
                    },
                    "fontWeight": {
                      "type": "integer",
                      "enum": [
                        400,
                        700
                      ]
                    },
                    "fontStyle": {
                      "type": "string",
                      "enum": [
                        "normal",
                        "italic"
                      ]
                    },
                    "textAlign": {
                      "type": "string",
                      "enum": [
                        "left",
                        "center",
                        "right",
                        "justify"
                      ]
                    }
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "needsReview": {
                  "type": "boolean"
                },
                "notes": {
                  "type": "string",
                  "maxLength": 1000
                },
                "borders": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "top",
                    "right",
                    "bottom",
                    "left"
                  ],
                  "properties": {
                    "top": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "right": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "bottom": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "left": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "tables": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tableId",
                "readingOrder",
                "columnEdges",
                "rowEdges",
                "cells",
                "style",
                "borders",
                "confidence",
                "needsReview",
                "notes",
                "headerRowCount"
              ],
              "properties": {
                "tableId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "readingOrder": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 12000
                },
                "columnEdges": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 101,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "rowEdges": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 1001,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "cells": {
                  "type": "array",
                  "maxItems": 10000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "row",
                      "column",
                      "rowSpan",
                      "columnSpan",
                      "text",
                      "borders"
                    ],
                    "properties": {
                      "row": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 999
                      },
                      "column": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 99
                      },
                      "rowSpan": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "columnSpan": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 100000
                      },
                      "borders": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "additionalProperties": false,
                        "required": [
                          "top",
                          "right",
                          "bottom",
                          "left"
                        ],
                        "properties": {
                          "top": {
                            "type": [
                              "boolean",
                              "null"
                            ]
                          },
                          "right": {
                            "type": [
                              "boolean",
                              "null"
                            ]
                          },
                          "bottom": {
                            "type": [
                              "boolean",
                              "null"
                            ]
                          },
                          "left": {
                            "type": [
                              "boolean",
                              "null"
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                "style": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "fontSizePt",
                    "fontWeight",
                    "fontStyle",
                    "textAlign",
                    "fontFamily",
                    "lineHeight",
                    "color"
                  ],
                  "properties": {
                    "fontFamily": {
                      "type": "string",
                      "enum": [
                        "Arial",
                        "Aptos",
                        "Calibri",
                        "Cambria",
                        "Times New Roman",
                        "Georgia",
                        "Verdana",
                        "Tahoma",
                        "Courier New"
                      ]
                    },
                    "lineHeight": {
                      "type": "number",
                      "minimum": 0.8,
                      "maximum": 3
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "fontSizePt": {
                      "type": "number",
                      "minimum": 4,
                      "maximum": 96
                    },
                    "fontWeight": {
                      "type": "integer",
                      "enum": [
                        400,
                        700
                      ]
                    },
                    "fontStyle": {
                      "type": "string",
                      "enum": [
                        "normal",
                        "italic"
                      ]
                    },
                    "textAlign": {
                      "type": "string",
                      "enum": [
                        "left",
                        "center",
                        "right",
                        "justify"
                      ]
                    }
                  }
                },
                "borders": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "top",
                    "right",
                    "bottom",
                    "left"
                  ],
                  "properties": {
                    "top": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "right": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "bottom": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "left": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "needsReview": {
                  "type": "boolean"
                },
                "notes": {
                  "type": "string",
                  "maxLength": 1000
                },
                "headerRowCount": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of leading column-heading rows on this page; 0 when absent. Never count a data row as a heading."
                }
              }
            }
          }
        }
      }
    }
  }
}
