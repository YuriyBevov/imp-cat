# OpenAI-compatible translation and document-review provider.
TRANSLATION_API_URL=https://api.aitunnel.ru/v1/chat/completions
TRANSLATION_API_KEY=
TRANSLATION_MODEL=

# Primary document-analysis route. Codex uses the local ChatGPT login (`codex login`)
# and sends rendered page images to OpenAI. No separate API key is required.
DOCUMENT_ANALYSIS_MODE=codex
CODEX_BIN=codex
CODEX_DOCUMENT_MODEL=gpt-5.6-sol
CODEX_DOCUMENT_TIMEOUT_MS=900000

# Legacy optional vision augmentation for DOCUMENT_ANALYSIS_MODE=local only.
DOCUMENT_VISION_ENABLED=false
DOCUMENT_VISION_MODEL=
DOCUMENT_VISION_AUTO_AUGMENT=true
DOCUMENT_VISION_MIN_CONFIDENCE=0.86

# Legacy cross-platform OCR. It is used only with DOCUMENT_ANALYSIS_MODE=local.
# Latin + Cyrillic cover the old test corpus.
# Add another RapidOCR language name when required, for example arabic or ch.
DOCUMENT_OCR_LANGUAGES=latin,cyrillic
DOCUMENT_OCR_DPI=300
DOCUMENT_OCR_MAX_PIXELS=16000000
DOCUMENT_OCR_TILING=true
DOCUMENT_OCR_TILE_SIZE=1800

# Local application server.
HOST=127.0.0.1
PORT=3100
