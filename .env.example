# OpenAI-compatible translation and document-review provider.
TRANSLATION_API_URL=https://api.aitunnel.ru/v1/chat/completions
TRANSLATION_API_KEY=replace-with-provider-key
TRANSLATION_MODEL=replace-with-text-model

# A vision-capable model may be separate from the translation model. When enabled,
# every page is checked after local OCR; high-confidence missing lines/corrections
# are added before the editor opens. Page images are sent to the configured API.
DOCUMENT_VISION_ENABLED=false
DOCUMENT_VISION_MODEL=replace-with-vision-model
DOCUMENT_VISION_AUTO_AUGMENT=true
DOCUMENT_VISION_MIN_CONFIDENCE=0.86

# Cross-platform local OCR. Latin + Cyrillic cover the current test corpus.
# Add another RapidOCR language name when required, for example arabic or ch.
DOCUMENT_OCR_LANGUAGES=latin,cyrillic
DOCUMENT_OCR_DPI=300
DOCUMENT_OCR_MAX_PIXELS=16000000
DOCUMENT_OCR_TILING=true
DOCUMENT_OCR_TILE_SIZE=1800

# Local application server.
HOST=127.0.0.1
PORT=3100
