# OpenAI-compatible translation and document-review provider.
TRANSLATION_API_URL=https://api.aitunnel.ru/v1/chat/completions
TRANSLATION_API_KEY=
TRANSLATION_MODEL=
AI_PROVIDER=aitunnel
# Обязательная локальная проверка перед отправкой документов в AI (по умолчанию включена).
DOCUMENT_PRIVACY_REQUIRED=1
# По умолчанию ~/.local/share/icat/privacy.key, хранить отдельно от документов и репозитория.
DOCUMENT_PRIVACY_KEY_FILE=
# По умолчанию .venv/bin/python; нужны requirements-privacy.txt, Tesseract и локальная NER-модель.
DOCUMENT_PRIVACY_PYTHON_BIN=
# Optional DNS override for server-side AI HTTPS requests only. Empty uses system DNS.
AI_DNS_SERVERS=

# Codex route uses the local ChatGPT login (`codex login`) and needs no API key.
CODEX_BIN=codex
CODEX_DOCUMENT_MODEL=gpt-5.6-sol
CODEX_DOCUMENT_TIMEOUT_MS=900000
DOCUMENT_JOB_CONCURRENCY=2
# Страниц в одном последовательном AI-пакете (1–4). Для полноты по умолчанию: 2.
DOCUMENT_AGENT_BATCH_PAGES=2
DOCUMENT_UPLOAD_MAX_MB=300

# Persistent translation knowledge base. PostgreSQL must have the pgvector extension.
DATABASE_URL=postgresql://icat:change-me@127.0.0.1:5433/icat
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Local application server.
HOST=127.0.0.1
PORT=3100
