# OpenAI-compatible translation and document-review provider.
TRANSLATION_API_URL=https://api.openai.com/v1/chat/completions
TRANSLATION_API_KEY=replace-with-provider-key
TRANSLATION_MODEL=gpt-5-mini

# Off by default. When true, the same configured AI provider receives page images
# during OCR review so it can find missing text and compare recognition with source.
DOCUMENT_VISION_ENABLED=false

# Local application server.
HOST=127.0.0.1
PORT=3100
