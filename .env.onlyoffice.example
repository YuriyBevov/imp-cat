# Reference values for local development. Export changed values in the shell
# before running Docker and Node so both processes receive the same settings.
ONLYOFFICE_PORT=8080
ONLYOFFICE_SERVER_URL=http://127.0.0.1:8080
ONLYOFFICE_DOWNLOAD_URL=http://127.0.0.1:8080
ONLYOFFICE_INTERNAL_APP_URL=http://host.docker.internal:3100
ONLYOFFICE_JWT_SECRET=icat-onlyoffice-local-secret-change-me
